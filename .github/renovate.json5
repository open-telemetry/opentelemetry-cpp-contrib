{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":separateMultipleMajorReleases",
  ],
  ignorePaths: [],
  prHourlyLimit: 10,
  packageRules: [
    {
      description: "Bundles all patches into 1 easy to review pr",
      groupName: "all patching",
      matchUpdateTypes: ["patch", "digest"],
      schedule: ["before 6am every weekday"],
    },
    {
      description: "Bundle all minor infra updates into 1 update",
      groupName: "infra updates",
      matchCategories: ["ci", "docker"],
      matchUpdateTypes: ["minor"],
      schedule: ["before 8am on Monday"],
    },
    {
      description: "Allow minor updates to be raised each Monday without approval",
      matchUpdateTypes: ["minor"],
      matchDepNames: ["!opentelemetry**", "!io_opentelemetry**"],
      schedule: ["before 8am on Monday"],
    },
    {
      description: "Allow major ci updates to be raised each Monday without approval",
      matchCategories: ["ci"],
      matchUpdateTypes: ["major"],
      schedule: ["before 8am on Monday"],
    },
    {
      description: "Require approval for all major updates except ci",
      dependencyDashboardApproval: true,
      matchCategories: ["!ci", "!elixir"],
      matchDepNames: ["!abseil-cpp"],
      matchManagers: ["!gradle"],
      matchUpdateTypes: ["major"],
    },
    {
      description: "Ensure otel is as up to date as possible with individual pr's per minor",
      matchDepNames: ["opentelemetry**", "io_opentelemetry**"],
      separateMultipleMinor: true,
      schedule: ["before 6am every weekday"],
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update cmake fetch content",
      managerFilePatterns: [
        "**/CMakeLists.txt",
        "**/*.cmake",
      ],
      matchStrings: [
        "FetchContent_Declare\\(\\n\\s+(?<depName>.+?)\\n\\s+GIT_REPOSITORY (\")?(?<registryUrl>https:\/\/.+?)\\/(?<packageName>.+).git(\")?\\n\\s+GIT_TAG (?<currentDigest>[a-f0-9]{40,64}) \\# (?<currentValue>v[0-9.]+)",
      ],
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
    },
  ],
  labels: ["dependencies"],
}
